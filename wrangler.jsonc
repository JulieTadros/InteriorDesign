{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "julie-tadros-interiors",
  "main": "cloudflare/portfolio-worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "10222027",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
